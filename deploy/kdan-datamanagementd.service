[Unit]
Description=KDAN Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=kdan
Group=kdan
WorkingDirectory=/opt/kdan
ExecStart=/opt/kdan/datamanagementd \
  -socket-path /tmp/kdan-datamanagement.sock \
  -sqlite-path /var/lib/kdan/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
