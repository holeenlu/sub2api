[Unit]
Description=Tokensavy Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=tokensavy
Group=tokensavy
WorkingDirectory=/opt/tokensavy
ExecStart=/opt/tokensavy/datamanagementd \
  -socket-path /tmp/tokensavy-datamanagement.sock \
  -sqlite-path /var/lib/tokensavy/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
