# Choose the SAME explicit release version as the backend.
# Brand images: kdan-vendor, tapmodels-vendor, tokensavy-vendor.
VENDOR_PORTAL_IMAGE=ghcr.io/holeenlu/tapmodels-vendor:REPLACE_WITH_BACKEND_VERSION
PORTAL_PUBLIC_ORIGIN=https://supplier.example.com
# Same Compose project; for server B use its private HTTP(S) origin instead.
BACKEND_ORIGIN=http://tapmodels:8080
PORTAL_BIND_HOST=127.0.0.1
PORTAL_PORT=8081
# Trust only the IP/CIDR of the immediate TLS proxy. Space-separated; none by default.
PORTAL_TRUSTED_PROXY_CIDRS=
