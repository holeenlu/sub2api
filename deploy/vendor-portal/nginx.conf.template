worker_processes auto;
pid /tmp/vendor-portal/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    client_body_temp_path /tmp/vendor-portal/client;
    proxy_temp_path /tmp/vendor-portal/proxy;
    fastcgi_temp_path /tmp/vendor-portal/fastcgi;
    uwsgi_temp_path /tmp/vendor-portal/uwsgi;
    scgi_temp_path /tmp/vendor-portal/scgi;
    client_max_body_size 64m;
    log_format portal '$remote_addr "$request_method $uri" $status $body_bytes_sent';
    access_log /dev/stdout portal;
    resolver ${PORTAL_RESOLVERS} valid=30s;
    resolver_timeout 5s;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    include /tmp/vendor-portal/trusted-proxies.conf;
    map "$status:$uri" $portal_cache_control {
        default "no-store";
        ~^(200|304):/assets/ "public, max-age=31536000, immutable";
    }
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control $portal_cache_control always;
    server {
        listen 8080 default_server;
        server_name _;
        location = /health { access_log off; return 200 "ok\n"; }
        location / { return 404; }
    }
    server {
        listen 8080;
        server_name ${PORTAL_HOST};
        root /usr/share/nginx/html;
        index index.html;
        set $backend_origin "${BACKEND_ORIGIN}";
        location = /health { access_log off; return 200 "ok\n"; }
        location = /portal-build.json { alias /etc/nginx/portal-build.json; }
        # Reuse the backend's live super-admin policy. Browser headers cannot
        # grant authority or choose a version; both are overwritten below.
        location = /_portal-update-auth {
            internal;
            proxy_pass $backend_origin/api/v1/admin/system/version;
            proxy_method GET;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host "${PORTAL_AUTHORITY}";
            proxy_set_header X-Forwarded-Proto "${PORTAL_SCHEME}";
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Admin-UI-Request "1";
            proxy_set_header Connection "";
            proxy_ssl_server_name on;
            proxy_ssl_name "${BACKEND_TLS_NAME}";
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_connect_timeout 5s;
            proxy_read_timeout 15s;
            proxy_next_upstream off;
        }
        location ~ ^/api/v1/portal-updater/(?<portal_update_action>status|update)$ {
            auth_request /_portal-update-auth;
            auth_request_set $portal_backend_version $upstream_http_x_portal_backend_version;
            proxy_set_header X-Portal-Authorized "1";
            proxy_set_header X-Portal-Backend-Version $portal_backend_version;
            proxy_set_header Authorization "";
            proxy_set_header Cookie "";
            proxy_set_header X-Api-Key "";
            proxy_pass http://unix:/run/portal-updater/updater.sock:/portal/$portal_update_action;
            proxy_connect_timeout 3s;
            proxy_read_timeout 15s;
            proxy_next_upstream off;
            client_max_body_size 256;
        }
        # Backend owns all role/ownership rules, including supplier admin APIs.
        location ~ ^/api/v1(?:/|$) {
            proxy_pass $backend_origin$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Host "${PORTAL_AUTHORITY}";
            proxy_set_header X-Forwarded-Host "${PORTAL_AUTHORITY}";
            proxy_set_header X-Forwarded-Proto "${PORTAL_SCHEME}";
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_intercept_errors off;
            proxy_next_upstream off;
            proxy_redirect off;
            proxy_ssl_server_name on;
            proxy_ssl_name "${BACKEND_TLS_NAME}";
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        }
        location ~ ^/(?:api|v1|v1beta|responses|admin|register|setup)(?:/|$) { return 404; }
        location ^~ /assets/ { try_files $uri =404; }
        location / { try_files $uri $uri/ /index.html; }
    }
}
