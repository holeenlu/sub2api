# API deployment; no frontend is built or served.
# Copy to .env, chmod 600 .env, then fill every empty required value.
# Never reuse production credentials, databases or volumes for this checkout.

# Deployment identity. Choose a fresh unique project for each instance.
COMPOSE_PROJECT_NAME=sub2api
APP_IMAGE=sub2api:local
BIND_HOST=127.0.0.1
# Host port only; the API always listens on container port 8080.
SERVER_PORT=8080
# Only read when explicitly adding -f compose.single.yaml; single replica only.
# APP_CONTAINER_NAME=sub2api-api-local

POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
# Required: generate distinct random values, e.g. openssl rand -hex 32.
# Hex also avoids DSN/dotenv quoting problems in the existing bootstrap code.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Required, fixed across restarts and replicas: at least 32 random bytes.
JWT_SECRET=
# Required, independent 64-hex-character key: openssl rand -hex 32.
TOTP_ENCRYPTION_KEY=
JWT_EXPIRE_HOUR=24
# 0 uses the existing first-setup default (60 seconds), not unlimited.
SETUP_MIGRATION_TIMEOUT_SECONDS=0
TZ=Asia/Shanghai

# External frontend integration is a later acceptance step.
# Exact comma-separated trusted proxy IPs/CIDRs and browser origins only.
# Empty proxy list trusts no forwarded IP; empty CORS list denies preflights.
SERVER_TRUSTED_PROXIES=
SERVER_FRONTEND_URL=
CORS_ALLOWED_ORIGINS=

# Optional existing upstream OAuth inputs. Leave unused clients empty.
# GEMINI_OAUTH_CLIENT_ID and GEMINI_OAUTH_CLIENT_SECRET must be set together.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
