[Unit]
Description=TapModels Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=tapmodels
Group=tapmodels
WorkingDirectory=/opt/tapmodels
ExecStart=/opt/tapmodels/datamanagementd \
  -socket-path /tmp/tapmodels-datamanagement.sock \
  -sqlite-path /var/lib/tapmodels/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
