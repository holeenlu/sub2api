[
  { "name": "empty", "input": "", "expected": "" },
  { "name": "whitespace", "input": " \t\n", "expected": "" },
  { "name": "trimmed root path", "input": " /brand/logo.svg ", "expected": "/brand/logo.svg" },
  { "name": "root", "input": "/", "expected": "/" },
  { "name": "protocol relative", "input": "//example.invalid/logo.svg", "expected": "" },
  { "name": "root backslash", "input": "/\\example.invalid/logo.svg", "expected": "" },
  { "name": "HTTP", "input": "http://example.invalid/logo.png", "expected": "http://example.invalid/logo.png" },
  { "name": "trimmed HTTPS", "input": " https://example.invalid/logo.svg ", "expected": "https://example.invalid/logo.svg" },
  { "name": "case insensitive scheme", "input": "HTTPS://example.invalid/logo.png", "expected": "HTTPS://example.invalid/logo.png" },
  { "name": "query needs HTML escaping", "input": "https://example.invalid/logo.png?x=\"&y=1", "expected": "https://example.invalid/logo.png?x=\"&y=1" },
  { "name": "userinfo", "input": "https://user:pass@example.invalid/logo.svg", "expected": "" },
  { "name": "empty userinfo", "input": "https://@example.invalid/logo.svg", "expected": "" },
  { "name": "missing host", "input": "https:///logo.svg", "expected": "" },
  { "name": "port without hostname", "input": "https://:443/logo.svg", "expected": "" },
  { "name": "missing authority", "input": "https:logo.svg", "expected": "" },
  { "name": "bad host", "input": "https://bad host/logo.svg", "expected": "" },
  { "name": "backslash URL", "input": "https://example.invalid\\logo.svg", "expected": "" },
  { "name": "CR", "input": "https://example.invalid/lo\rgo.svg", "expected": "" },
  { "name": "LF", "input": "/lo\ngo.svg", "expected": "" },
  { "name": "TAB", "input": "data:image/svg+xml,<svg>\t</svg>", "expected": "" },
  { "name": "javascript", "input": "javascript:alert(1)", "expected": "" },
  { "name": "file", "input": "file:///logo.svg", "expected": "" },
  { "name": "relative path", "input": "logo.svg", "expected": "" },
  { "name": "nonimage data", "input": "data:text/html,<script></script>", "expected": "" },
  { "name": "PNG data", "input": "data:image/png;base64,cG5n", "expected": "data:image/png;base64,cG5n" },
  { "name": "uppercase image data", "input": "DATA:IMAGE/PNG;BASE64,cG5n", "expected": "DATA:IMAGE/PNG;BASE64,cG5n" },
  { "name": "SVG data", "input": "data:image/svg+xml;charset=utf-8,%3Csvg%3EA+B%3C/svg%3E", "expected": "data:image/svg+xml;charset=utf-8,%3Csvg%3EA+B%3C/svg%3E" },
  { "name": "missing payload separator is decoded separately", "input": "data:image/png;base64", "expected": "data:image/png;base64" },
  { "name": "empty payload is decoded separately", "input": "data:image/png;base64,", "expected": "data:image/png;base64," },
  { "name": "bad base64 is decoded separately", "input": "data:image/png;base64,invalid", "expected": "data:image/png;base64,invalid" },
  { "name": "bad data escape is decoded separately", "input": "data:image/svg+xml,%GG", "expected": "data:image/svg+xml,%GG" }
]
