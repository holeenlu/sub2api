{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sub2API frontend acceptance catalog",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "execution_gate",
    "counts",
    "cases",
    "execution_matrix",
    "defaults"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "authored_not_executed"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "module",
          "layer",
          "priority",
          "roles",
          "fixture_ids",
          "preconditions",
          "steps",
          "expected",
          "source",
          "initial_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FE-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "static",
              "unit_component",
              "local_e2e",
              "external_e2e",
              "manual"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "fixture_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "cleanup": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(frontend|tools|docs|deploy)/"
            }
          },
          "initial_status": {
            "const": "not_run"
          },
          "route": {
            "type": "string"
          },
          "additional_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "variants": {
            "type": "array"
          },
          "role_expectations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "object",
      "required": [
        "cleanup",
        "required_evidence"
      ],
      "properties": {
        "cleanup": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
